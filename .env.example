# DeepSeek 模型服务配置（复制本文件为 .env 后填写；.env 已被 .gitignore 忽略）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_TIMEOUT=60
DEEPSEEK_TEMPERATURE=0.0
# DeepSeek V4.x 思考模式（数字开关）：1=深度思考常开（最准最慢）；0=关闭思考（最快）
# 其他值：auto=按需求复杂度自动切换；留空=服务端默认（思考开启、强度 high）
# 交互模式内可随时切换、立即生效，无需重启：:think 1 / :think 0 / :think auto
EXCELCR_THINKING=0
# 思考强度：low / high / max（留空=默认 high；思考模式下 temperature 不生效）
EXCELCR_REASONING_EFFORT=
# 代理设置：留空表示沿用系统代理（会自动修正 https:// 指向本机代理的错误写法）
# 需要指定代理时填 http://127.0.0.1:10808；想强制直连则把 EXCELCR_TRUST_ENV 设为 0
EXCELCR_PROXY=
EXCELCR_TRUST_ENV=1

# 校验失败后允许模型自动修复的次数
EXCELCR_MAX_REPAIR=2
# 目录白名单，多个用 ; 分隔（Windows）；留空表示只允许当前工作目录
EXCELCR_ALLOWED_DIRS=
# 日志目录
EXCELCR_LOG_DIR=logs
# 写入前是否备份原文件（0 关闭）
EXCELCR_BACKUP=1
